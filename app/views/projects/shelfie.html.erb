<% projet = projet_courant %>

<%= render layout: "projects/entete", locals: { projet: projet } do %>
  <p>
    Projet d’équipe réalisé pendant le bootcamp Le Wagon : une appli contre le gaspillage à la maison. Fini les dates oubliées et la saisie à la main.
  </p>
  <p>
    On scanne son ticket de caisse. L’appli enregistre les produits et prévient avant la date limite. Puis une IA propose des recettes avec ce qu’il faut manger en premier.
  </p>
  <p>
    J’ai créé la charte (logo, couleurs, pictogrammes, typos) et les écrans clés. J’ai aussi codé tout le front.
  </p>
  <p>
    L’appli fonctionne. On l’a présentée le jour de la démo finale.
  </p>
<% end %>

<div class="projet-medias">
  <%= render "projects/media_paire", medias: [
        { image: "shelfie/logoshelfie.jpg",
          alt: "Logo Shelfie, lettrage vert clair sur fond vert sombre" },
        { image: "shelfie/carre.png", width: 1200, height: 1200,
          alt: "Visuel carré Shelfie : « Scanne. Range. Cuisine. », avec les écrans accueil, scan et recettes IA" }
      ] %>

  <%= render "projects/media_pleine",
        media: { image: "shelfie/3981779.jpg", width: 8000, height: 4000,
                 alt: "Écrans de l’application Shelfie : accueil, connexion, ingrédients, recettes et étagère de produits" } %>

  <%# Bannière : tmp/import/shelfie/ → bin/rails cloudinary:import_projets (absente du manifeste = non affichée) %>
  <%= projet_bloc_medias(
        { image: "shelfie/banniere.png", width: 1600, height: 900,
          alt: "Bannière Shelfie : « Ton frigo, sous contrôle. », avec les écrans scan du ticket, validation, détail, recettes IA et alerte DLC" }) %>

  <%# Planche : tmp/import/shelfie/ → bin/rails cloudinary:import_projets (absente du manifeste = non affichée) %>
  <% planche = { image: "shelfie/planche-complete.png", width: 2560, height: 2892,
                 alt: "Planche de conception Shelfie sur fond vert forêt : parcours principal, arborescence, composants (logo, couleurs, boutons), wireframes de chaque étape, états de l’étagère et hypothèses du test utilisateur" } %>
  <% if media_disponible?(planche) %>
    <%= render "projects/media_pleine", media: planche,
          legende: "Parcours, arborescence, composants, wireframes et protocole de test." %>
  <% end %>

  <%# Protocole de test : fichier statique (public/projets/), ouvert dans un nouvel onglet %>
  <p>
    <%= link_to "/projets/protocole-test-shelfie.pdf", class: "lien-pill", target: "_blank", rel: "noopener" do %>Protocole de test (PDF) <span aria-hidden="true">↗</span><span class="visually-hidden">(nouvel onglet)</span><% end %>
  </p>
</div>

<%= render "projects/navigation", projet: projet %>
