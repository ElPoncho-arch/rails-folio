<% projet = projet_courant %>

<%= render layout: "projects/entete", locals: { projet: projet } do %>
  <p>
    Projet d’école : une nouvelle identité pour le MAC VAL, musée de la scène artistique française depuis les années 1950. Elle parle à tous, de l’amateur au spécialiste.
  </p>
  <p>
    Le logo est tracé à la main, comme le geste de l’artiste. Le rectangle ? Une porte ouverte sur l’art. Il revient partout, comme un fil conducteur. Le logo existe aussi en version animée.
  </p>
  <p>
    L’identité va des affiches d’exposition à la signalétique, en passant par la papeterie, les badges et le web.
  </p>
<% end %>

<div class="projet-medias">
  <%= render "projects/media_pleine",
        media: { image: "macval/bandeau web noir.jpg", width: 4000, height: 1999,
                 alt: "Bandeau web MAC VAL : logo manuscrit noir sur un rectangle bleu, lignes bleues sur fond blanc" } %>

  <%= render "projects/media_paire", medias: [
        { video: "macval-logo-anim_syyto5", largeur: 1080, attente: 5,
          alt: "Logo MAC VAL animé : lettres manuscrites noires sur un rectangle bleu, lignes bleues et nom du musée" },
        { image: "macval/expo-affiche-2.jpg",
          alt: "Affiche d’exposition MAC VAL bleu nuit, suspendue" }
      ] %>

  <%= render "projects/media_pleine",
        media: { image: "macval/Branding_Mockup_2.jpg", width: 4000, height: 1999,
                 alt: "Papeterie MAC VAL : cartes de visite, enveloppes et papier à en-tête" } %>

  <%= render "projects/media_paire", medias: [
        { image: "macval/expo-affiche-1.jpg",
          alt: "Affiche d’exposition MAC VAL consacrée à Nil Yalter, photographies en noir et bleu" },
        { image: "macval/magnet.jpg",
          alt: "Badges ronds MAC VAL, blancs, noirs et vert" }
      ] %>

  <%= render "projects/media_paire", medias: [
        { image: "macval/MU-a-entree-2.jpg",
          alt: "Panneau de signalétique MAC VAL à l’entrée : directions vers les expositions et le vestiaire" },
        { image: "macval/MU-CENTRE-DE-DOC-2.jpg",
          alt: "Signalétique « Centre de documentation » sur un mur blanc, vitrines au premier plan" }
      ] %>
</div>

<%= render "projects/navigation", projet: projet %>
