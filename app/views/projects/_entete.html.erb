<%# En-tête de page projet — usage : render layout: "projects/entete", locals: { projet: projet_courant } do … texte … end %>
<%# Titre de page : nom court, sans sous-titre (« TF1 — E-learning » → « TF1 ») %>
<% content_for :titre, projet[:nom].split(" — ").first %>
<header class="projet-entete">
  <div class="projet-entete__haut" data-reveal-target="item">
    <%= link_to "← tous les projets", "/#projets", class: "projet-entete__retour" %>
    <span class="projet-entete__numero"><%= projet_numero(projet) %> / <%= format("%02d", projets.size) %></span>
  </div>

  <h1 class="projet-entete__titre" data-controller="split-title" data-split-title-type-value="words"><%= nom_insecable(projet[:nom]) %></h1>

  <%# Étiquettes détaillées si le projet en a (nouveaux projets), sinon les tags de la home %>
  <ul class="projet-entete__tags" aria-label="Étiquettes" data-reveal-target="item">
    <% (projet[:etiquettes] || projet[:tags]).each do |tag| %>
      <li class="tag-pill"><%= tag %></li>
    <% end %>
  </ul>

  <div class="projet-entete__corps" data-reveal-target="item">
    <div class="projet-entete__texte">
      <%= yield %>
    </div>

    <% infos = { "contexte" => projet[:contexte], "rôle" => projet[:role],
                 "durée" => projet[:duree], "outils" => projet[:outils] }.compact %>
    <% if infos.any? %>
      <dl class="projet-entete__infos">
        <% infos.each do |libelle, valeur| %>
          <dt><%= libelle %></dt>
          <dd><%= valeur %></dd>
        <% end %>
      </dl>
    <% end %>
  </div>
</header>
