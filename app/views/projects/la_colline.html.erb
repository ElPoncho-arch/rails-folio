<% projet = projet_courant %>

<%= render layout: "projects/entete", locals: { projet: projet } do %>
  <p>
    Les formes modernes et épurées présentes sur l’étiquette évoquent la manière
    de produire l’huile d’olive via des illustrations simples et linéaires.
    Le cheval, quant à lui, symbolise la fertilité et la prospérité.
    Le code couleur fait référence aux inspirations méditerranéennes.
  </p>
<% end %>

<div class="projet-medias">
  <%= render "projects/media_pleine",
        media: { image: "lacolline/banniere.jpg", width: 11339, height: 5669,
                 alt: "Bannière La Colline Olive Oil : illustrations linéaires dorées sur fond vert sombre" } %>

  <%= render "projects/media_paire", medias: [
        { image: "lacolline/mobile2.jpg",
          alt: "Déclinaisons imprimées et écran mobile aux couleurs de La Colline" },
        { image: "lacolline/Glass_Oil_Bottle_2.jpg",
          alt: "Trois bouteilles d’huile d’olive La Colline et leurs étiquettes illustrées, sur fond noir" }
      ] %>

  <%= render "projects/media_pleine", ratio: "16 / 9",
        media: { image: "lacolline/laptop1.jpg",
                 alt: "Site de La Colline affiché sur un ordinateur portable et des écrans" } %>
</div>

<%= render "projects/navigation", projet: projet %>
