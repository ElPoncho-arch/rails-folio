<% projet = projet_courant %>

<%= render layout: "projects/entete", locals: { projet: projet } do %>
  <p>
    Un abécédaire du skate, pour apprendre l’alphabet. Il parle aux jeunes comme aux passionnés.
  </p>
  <p>
    Les 26 lettres sont faites de photos de skate, en noir et blanc. Une lettre par double page, avec un rythme entre image et texte.
  </p>
  <p>
    Chaque page raconte un bout de cette culture : pionniers, figures, lieux mythiques, compétitions.
  </p>
  <p>
    Créé à plusieurs, pour un événement.
  </p>
<% end %>

<div class="projet-medias">
  <%= render "projects/media_paire", medias: [
        { image: "abc/livre.jpg",
          alt: "Couverture de l’Abécédaire posée contre un mur : grandes lettres et photo de skate en noir et blanc" },
        { image: "abc/mu-double2.jpg",
          alt: "Double page de l’Abécédaire : la lettre P en photo-typographie noir et blanc" }
      ] %>

  <%= render "projects/media_paire", medias: [
        { image: "abc/mu-double.jpg",
          alt: "Double page de l’Abécédaire : la lettre M en noir et blanc" },
        { image: "abc/abc.jpg",
          alt: "Les 26 lettres de l’Abécédaire, chacune composée à partir de photos de skate" }
      ] %>

  <%= render "projects/media_pleine",
        media: { image: "abc/mu-page.jpg", width: 3208, height: 2190,
                 alt: "Pages de l’Abécédaire étalées : lettres composées de photos de skate en noir et blanc" } %>
</div>

<%= render "projects/navigation", projet: projet %>
