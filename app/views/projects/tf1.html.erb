<% projet = projet_courant %>

<%= render layout: "projects/entete", locals: { projet: projet } do %>
  <p><em>Transition environnementale dans l’audiovisuel</em></p>
  <p>
    Conçu pour le Groupe TF1 et ses partenaires, ce module e-learning vise à sensibiliser l’ensemble des professionnels de l’audiovisuel aux enjeux de la transition environnementale. Pensé comme un outil pédagogique accessible et impactant pour encourager des pratiques plus responsables sur l’ensemble de la chaîne de production.
  </p>
  <p>
    Ce projet a été réalisé au sein de l’agence Tremplin Numérique, en collaboration avec une équipe d’illustrateurs et de motion designers talentueux.
  </p>
<% end %>

<div class="projet-medias">
  <%= render "projects/media_pleine", ratio: "16 / 9",
        media: { video: "teaser_nfmktr", lecteur: true, largeur: 1920, attente: 2,
                 alt: "Teaser du module e-learning TF1" } %>

  <%= render "projects/media_paire", medias: [
        { video: "JEU_ECHEC_myvor0",
          alt: "Animation du jeu d’échecs du module" },
        { video: "JEU_MOTS_CROISEES_f5me6a",
          alt: "Animation du jeu de mots croisés du module" }
      ] %>

  <%= render "projects/media_pleine",
        media: { cl_gif: "tf1mu_rgu01t", width: 1728, height: 864,
                 alt: "Module e-learning TF1 sur un ordinateur portable : plusieurs écrans illustrés qui défilent" } %>
</div>

<%= render "projects/navigation", projet: projet %>
