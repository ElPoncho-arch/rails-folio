<% projet = projet_courant %>

<%= render layout: "projects/entete", locals: { projet: projet } do %>
  <p>
    Projet de diplôme : une expo pour raconter l’histoire du skate, né en Californie au début des années 1960. Pour ceux qui en font comme pour les curieux.
  </p>
  <p>
    Le logo reprend les codes skate des années 1980 : typo punk, lettres découpées, esprit «&nbsp;fais-le toi-même&nbsp;». Il s’anime, en jaune et noir. Le jaune, pour l’énergie et la curiosité.
  </p>
  <p>
    L’identité vit sur les affiches, les billets, la papeterie, le catalogue et un sac en toile. J’ai aussi imaginé le parcours de l’expo et l’affichage dans la rue.
  </p>
<% end %>

<div class="projet-medias">
  <%= render "projects/media_pleine", ratio: "16 / 9",
        media: { video: "slides_logo_anim_meykfx", largeur: 1080, attente: 1,
                 alt: "Logo Slides animé : lettres découpées noires sur fond jaune" } %>

  <%= render "projects/media_pleine",
        media: { image: "slides/slide_branding_31.jpg", width: 3500, height: 2380,
                 alt: "Affiche Slides jaune et noire déroulée, avec billets et cartes" } %>

  <%= render "projects/media_paire", medias: [
        { image: "slides/slide_branding_1.jpg",
          alt: "Série d’affiches Slides jaunes et noires" },
        { image: "slides/slide_branding_2.jpg",
          alt: "Papeterie Slides : papier à en-tête, enveloppes et cartes jaunes et noires" }
      ] %>

  <%= render "projects/media_paire", medias: [
        { image: "slides/billet-evenement_134533-5.jpg",
          alt: "Billets d’entrée de l’exposition Slides, jaunes et noirs" },
        { image: "slides/catalogue.gif",
          alt: "Catalogue de l’exposition Slides feuilleté, en animation" }
      ] %>

  <%= render "projects/media_pleine",
        media: { image: "slides/urban_poster_mockup.jpg", width: 2500, height: 1667,
                 alt: "Trois affiches Slides collées sur un mur extérieur, chaises bleues au premier plan" } %>

  <%= render "projects/media_paire", medias: [
        { image: "slides/sceno.gif",
          alt: "Scénographie de l’exposition Slides dans le bâtiment, en animation" },
        { image: "slides/totebag2.jpg",
          alt: "Sac en toile Slides blanc accroché à un mur" }
      ] %>
</div>

<%= render "projects/navigation", projet: projet %>
