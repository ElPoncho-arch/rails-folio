<% projet = projet_courant %>

<%= render layout: "projects/entete", locals: { projet: projet } do %>
  <p>
    Brochure retraçant l’histoire de la marque Ford de ses débuts en 1891
    en passant par le fordisme, la création du modèle T, la célèbre Mustang,
    ses courses des 24 Heures du Mans, jusqu’à nos jours.
  </p>
<% end %>

<div class="projet-medias">
  <%= render "projects/media_paire", medias: [
        { image: "ford/MU_Couv_Ford.jpg",
          alt: "Couverture de la brochure Ford : grandes lettres découpées blanches et bleues sur fond noir" },
        { image: "ford/Mockup_Ford.jpg",
          alt: "Doubles pages de la brochure étalées : typographies colorées, photos d’archives, hommage à Paul Rand" }
      ] %>
</div>

<%= render "projects/navigation", projet: projet %>
