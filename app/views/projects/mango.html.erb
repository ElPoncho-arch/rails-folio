<% projet = projet_courant %>

<%= render layout: "projects/entete", locals: { projet: projet } do %>
  <p>
    Le nouveau logo de Mango Édition a pour principal objectif de traduire le renouveau à travers le cycle.
    Le logo circulaire est impactant, reconnaissable et mémorisable pour tous.
    Le cercle symbolise l’unité et la régularité de la marque.
  </p>
<% end %>

<div class="projet-medias">
  <%= render "projects/media_paire", medias: [
        { image: "mango/logomango2.gif",
          alt: "Logo Mango Édition animé : le nom entouré d’un cercle orange" },
        { image: "mango/carte.jpg",
          alt: "Cartes de visite Mango Édition, recto et verso" }
      ] %>

  <%= render "projects/media_paire", medias: [
        { image: "mango/livre-1.jpg",
          alt: "Couverture d’un livre Mango Édition, illustration végétale sur fond corail" },
        { image: "mango/livre-2.jpg",
          alt: "Deux livres de cuisine Mango Édition aux couvertures illustrées, sur fond turquoise" }
      ] %>
</div>

<%= render "projects/navigation", projet: projet %>
