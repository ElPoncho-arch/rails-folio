<%# Nav pilule flottante — comportement dans nav_controller.js %>
<% liens = [["projets", "/#projets"], ["à propos", a_propos_path], ["contact", contact_path]] %>

<header class="site-nav" data-controller="nav"
        data-action="scroll@window->nav#onScroll keydown@window->nav#onKeydown resize@window->nav#onResize">
  <nav class="nav-pill" aria-label="Navigation principale" data-nav-target="pill"
       data-action="mouseenter->nav#expand mouseleave->nav#onLeave">
    <%= link_to "fabien hoarau", root_path, class: "nav-pill__brand" %>

    <ul class="nav-pill__links">
      <% liens.each do |label, path| %>
        <li>
          <%= link_to label, path, class: "nav-pill__link",
                aria: { current: ("page" if current_page?(path)) } %>
        </li>
      <% end %>
    </ul>

    <span class="nav-pill__badge">
      <span class="nav-pill__dot" aria-hidden="true"></span>
    </span>

    <button type="button" class="nav-pill__toggle"
            aria-expanded="false" aria-controls="nav-panel"
            data-nav-target="toggle" data-action="nav#toggle">menu</button>
  </nav>

  <%# Panneau plein écran (mobile) %>
  <div id="nav-panel" class="nav-panel" data-nav-target="panel" hidden>
    <ul class="nav-panel__links">
      <% liens.each do |label, path| %>
        <li>
          <%= link_to label, path, class: "nav-panel__link",
                aria: { current: ("page" if current_page?(path)) } %>
        </li>
      <% end %>
    </ul>
  </div>
</header>
