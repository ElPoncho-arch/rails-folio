<%# Footer — bande tomate (défilement à l'étape 9) + bloc encre %>
<footer class="site-footer">
  <div class="footer-band" aria-hidden="true">
    <p class="footer-band__text">
      <% 4.times do %>
        <span>disponible pour de nouveaux projets</span>
        <span class="footer-band__sep">✶</span>
        <span>graphisme · motion · UI · front</span>
        <span class="footer-band__sep">✶</span>
      <% end %>
    </p>
  </div>

  <div class="footer-main">
    <p class="footer-main__accroche">Un projet en tête ?<br>Parlons-en.</p>

    <a class="footer-main__email" href="mailto:hoarauf4@gmail.com">
      hoarauf4@gmail.com <span aria-hidden="true">↗</span>
    </a>

    <div class="footer-main__cols">
      <nav class="footer-col" aria-label="Pages">
        <p class="footer-col__titre">pages</p>
        <ul>
          <li><%= link_to "projets", work_path %></li>
          <li><%= link_to "à propos", bio_path %></li>
          <li><%= link_to "contact", contact_path %></li>
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Ailleurs">
        <p class="footer-col__titre">ailleurs</p>
        <ul>
          <li>
            <%= link_to "https://www.linkedin.com/in/fabien-hoarau-7b896a172/", target: "_blank", rel: "noopener noreferrer" do %>
              LinkedIn <span aria-hidden="true">↗</span><span class="visually-hidden">(nouvel onglet)</span>
            <% end %>
          </li>
          <li>
            <%= link_to "https://github.com/ElPoncho-arch/rails-folio", target: "_blank", rel: "noopener noreferrer" do %>
              GitHub <span aria-hidden="true">↗</span><span class="visually-hidden">(nouvel onglet)</span>
            <% end %>
          </li>
          <li>
            <%= link_to asset_path("FabienHoarau_UIDesigner.pdf"), target: "_blank", rel: "noopener noreferrer" do %>
              CV (pdf) <span aria-hidden="true">↗</span><span class="visually-hidden">(nouvel onglet)</span>
            <% end %>
          </li>
        </ul>
      </nav>

      <div class="footer-col footer-col--legal">
        <p>&copy; <%= Time.current.year %> Fabien Hoarau</p>
        <ul>
          <li><%= link_to "mentions légales", mentions_legales_path %></li>
          <li><a href="#page">↑ haut de page</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
