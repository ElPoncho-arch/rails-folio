<%# Profil et contact — en haut, la présentation : mobile : titre puis texte ;
    tablette et desktop (md) : titre sur toute la largeur, texte dans les deux tiers de droite.
    Bloc « Téléchargez mon CV » : petit jeu de panier (panier_cv_controller.js, _panier_cv.scss) ; un panier marqué
    télécharge le PDF via le lien « télécharger un CV », qui reste le raccourci direct (seul visible en mouvement réduit).
    En bas, #contact « Me contacter » : contact direct à gauche, formulaire à droite (empilés en mobile).
    Champs avec texte d'exemple (placeholder), libellés gardés pour les lecteurs d'écran ;
    piège anti-robots : champ « site_web » invisible, que seuls les robots remplissent.
    Vérification à la sortie de chaque champ : formulaire_controller.js ; vérification serveur : Contact. %>
<% content_for :titre, "Profil et contact" %>
<% champs = [
     { nom: :name,    etiquette: "Nom",     type: :text_field,  attrs: { autocomplete: "name", required: true, placeholder: "Nom" } },
     { nom: :email,   etiquette: "E-mail",  type: :email_field, attrs: { autocomplete: "email", required: true, placeholder: "E-mail" } },
     { nom: :message, etiquette: "Message", type: :text_area,   attrs: { rows: 6, required: true, minlength: 10, placeholder: "Message" },
       aide: "10 caractères minimum" }
   ] %>
<% outils = {
     "outils design" => ["Illustrator", "Photoshop", "InDesign", "After Effects", "Premiere Pro", "Figma"],
     "outils dev"    => ["HTML/CSS", "JavaScript", "Ruby on Rails", "SQL", "Bootstrap"]
   } %>

<article class="apropos">
  <header class="apropos__entete" data-reveal-target="item">
    <h1 class="apropos__titre">Profil et contact</h1>
    <p class="apropos__roles">Graphique, motion, UI et front-end designer</p>
    <%# Téléchargement direct du CV, dès le premier écran %>
    <%= link_to asset_path("FabienHoarau_UIDesigner.pdf"), class: "apropos__cv", download: "CV_Fabien-Hoarau.pdf" do %>télécharger un CV <span aria-hidden="true">↓</span><% end %>
  </header>

  <div class="apropos__corps">
    <p class="apropos__accroche" data-reveal-target="item">Designer, coder.</p>

    <div class="apropos__texte" data-reveal-target="item">
      <p>Je suis graphiste. Je conçois des identités visuelles, je les anime et je les développe pour le web.</p>
      <p>J’ai fait mes armes en agence de communication. J’y ai dirigé un pôle graphisme, piloté une équipe de 15 personnes et travaillé pour la Métropole du Grand Paris et le Groupe TF1.</p>
      <p>Chez un imprimeur, j’ai appris la rigueur de la fabrication : couleurs, formats, finitions. Du fichier à l’objet imprimé, rien n’est laissé au hasard.</p>
      <p>Formé au développement web au Wagon, je code moi-même mes interfaces. La maquette et le code avancent ensemble, sans rien perdre en route.</p>
      <p>Aujourd’hui, je travaille en indépendant avec des agences, des studios et des marques : une identité, une animation, une interface, ou les trois à la fois.</p>
    </div>

    <dl class="apropos__outils" data-reveal-target="item">
      <% outils.each do |titre, liste| %>
        <div class="apropos__outils-ligne">
          <dt><%= titre %></dt>
          <dd>
            <ul class="apropos__pilules">
              <% liste.each do |outil| %>
                <li class="tag-pill"><%= outil %></li>
              <% end %>
            </ul>
          </dd>
        </div>
      <% end %>
    </dl>

    <section class="apropos-cv" aria-labelledby="cv-titre" data-controller="panier-cv" data-reveal-target="item">
      <h2 class="apropos-cv__titre" id="cv-titre">Téléchargez mon CV</h2>
      <p class="apropos-cv__aide">Attrapez le fichier, tirez vers le bas, visez le panier. Ou prenez le raccourci juste en dessous.</p>

      <div class="panier" data-panier-cv-target="terrain">
        <div class="panier__tete">
          <span class="panier__score">paniers <strong data-panier-cv-target="score">0</strong></span>
        </div>

        <div class="panier__carte" data-panier-cv-target="carte">
          <div class="panier__infos">
            <div class="panier__nom">CV_Fabien-Hoarau.pdf</div>
            <div class="panier__poids">PDF · <%= poids_fichier(Rails.root.join("app/assets/images/FabienHoarau_UIDesigner.pdf")) %></div>
          </div>
          <div class="panier__etat">
            <span data-panier-cv-target="etat" role="status" aria-live="polite">prêt à tirer</span>
            <div class="panier__jauge"><span class="panier__jauge-barre" data-panier-cv-target="jauge"></span></div>
          </div>
          <div class="panier__coche" aria-hidden="true">✓</div>
        </div>

        <canvas aria-hidden="true" data-panier-cv-target="canvas"></canvas>
        <div class="panier__poignee" aria-hidden="true" data-panier-cv-target="poignee"></div>
      </div>

      <ul class="apropos__liens" aria-label="Liens">
        <li>
          <%= link_to asset_path("FabienHoarau_UIDesigner.pdf"), class: "lien-pill lien-pill--plein", download: "CV_Fabien-Hoarau.pdf",
                      data: { panier_cv_target: "lien", action: "panier-cv#telecharger" } do %>télécharger un CV <span aria-hidden="true">↓</span><% end %>
        </li>
        <li>
          <%= link_to "https://github.com/ElPoncho-arch", class: "lien-pill", target: "_blank", rel: "noopener noreferrer" do %>
            GitHub <span aria-hidden="true">↗</span><span class="visually-hidden">(nouvel onglet)</span>
          <% end %>
        </li>
      </ul>
    </section>
  </div>
</article>

<%# Me contacter : formulaire de contact (ancienne page /contact, redirigée ici) %>
<section id="contact" class="contact" aria-labelledby="contact-titre">
  <div class="contact__direct" data-reveal-target="item">
    <h2 id="contact-titre" class="contact__titre">Me contacter</h2>
    <p class="contact__accroche">Parlons de votre projet</p>
    <a class="contact__email" href="mailto:hoarauf4@gmail.com">hoarauf4@gmail.com</a>
    <%= link_to "https://www.linkedin.com/in/fabien-hoarau-7b896a172/", class: "lien-pill", target: "_blank", rel: "noopener noreferrer" do %>
      LinkedIn <span aria-hidden="true">↗</span><span class="visually-hidden">(nouvel onglet)</span>
    <% end %>
    <p class="contact__ou" aria-hidden="true">ou</p>
  </div>

  <%= form_with model: @contact, scope: :contact, url: contacts_path,
                class: "formulaire", html: { "aria-labelledby": "contact-titre" },
                data: { controller: "formulaire",
                                             action: "submit->formulaire#envoyer turbo:submit-end->formulaire#fin" } do |f| %>
    <%# Piège anti-robots : hors écran, ignoré par le clavier et les lecteurs d'écran %>
    <div class="formulaire__piege" aria-hidden="true">
      <%= f.label :site_web, "Site web" %>
      <%= f.text_field :site_web, tabindex: -1, autocomplete: "off" %>
    </div>

    <% champs.each do |champ| %>
      <% invalide = @contact.errors[champ[:nom]].any? %>
      <% erreur = @contact.errors[champ[:nom]].find(&:present?) %>
      <% id_erreur = "erreur-#{champ[:nom]}" %>
      <% id_aide = "aide-#{champ[:nom]}" if champ[:aide] %>
      <div class="formulaire__champ">
        <%# Libellé invisible : le texte d'exemple le remplace à l'écran %>
        <%= f.label champ[:nom], champ[:etiquette], class: "formulaire__etiquette visually-hidden" %>
        <%= f.public_send champ[:type], champ[:nom],
              class: "formulaire__saisie",
              aria: { describedby: [id_aide, id_erreur].compact.join(" "), invalid: (invalide ? "true" : nil) },
              data: { formulaire_target: "champ", action: "blur->formulaire#verifier input->formulaire#corriger" },
              **champ[:attrs] %>
        <% if champ[:aide] %>
          <p class="formulaire__aide" id="<%= id_aide %>"><%= champ[:aide] %></p>
        <% end %>
        <p class="formulaire__erreur" id="<%= id_erreur %>"<%= " hidden" unless erreur %>><%= erreur %></p>
      </div>
    <% end %>

    <button type="submit" class="formulaire__bouton" data-formulaire-target="bouton">
      Envoyer <span aria-hidden="true">→</span>
    </button>

    <%# Message présent au chargement (redirection après envoi, ou 422) : le focus y est posé par formulaire_controller %>
    <% erreurs = @contact.errors.any? %>
    <% statut = flash[:notice] || flash[:alert] || ("Vérifiez les champs signalés." if erreurs) %>
    <p class="formulaire__statut <%= 'formulaire__statut--erreur' if flash[:alert] || erreurs %>"
       role="status" data-formulaire-target="statut"<%= " hidden" unless statut %>><%= statut %></p>
  <% end %>
</section>
