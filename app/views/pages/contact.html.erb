<%# Contact — composition B : contact direct à gauche, formulaire à droite (empilés en mobile).
    Vérification à la sortie de chaque champ : formulaire_controller.js ; vérification serveur : Contact. %>
<% content_for :titre, "Contact" %>
<% champs = [
     { nom: :name,    etiquette: "Nom",     type: :text_field,  attrs: { autocomplete: "name", required: true } },
     { nom: :email,   etiquette: "E-mail",  type: :email_field, attrs: { autocomplete: "email", required: true } },
     { nom: :message, etiquette: "Message", type: :text_area,   attrs: { rows: 6, required: true, minlength: 10 } }
   ] %>

<section class="contact">
  <div class="contact__direct" data-reveal-target="item">
    <h1 class="contact__titre">Parlons de votre projet</h1>
    <p class="contact__dispo">
      <span class="nav-pill__dot" aria-hidden="true"></span> disponible pour de nouveaux projets
    </p>
    <a class="contact__email" href="mailto:hoarauf4@gmail.com">hoarauf4@gmail.com</a>
    <%= link_to "https://www.linkedin.com/in/fabien-hoarau-7b896a172/", class: "lien-pill", target: "_blank", rel: "noopener noreferrer" do %>
      LinkedIn <span aria-hidden="true">↗</span><span class="visually-hidden">(nouvel onglet)</span>
    <% end %>
    <p class="contact__ou" aria-hidden="true">ou</p>
  </div>

  <%= form_with model: @contact, scope: :contact, url: contacts_path,
                class: "formulaire", data: { controller: "formulaire",
                                             action: "submit->formulaire#envoyer turbo:submit-end->formulaire#fin" } do |f| %>
    <% champs.each do |champ| %>
      <% erreur = @contact.errors[champ[:nom]].first %>
      <% id_erreur = "erreur-#{champ[:nom]}" %>
      <div class="formulaire__champ">
        <%= f.label champ[:nom], champ[:etiquette], class: "formulaire__etiquette" %>
        <%= f.public_send champ[:type], champ[:nom],
              class: "formulaire__saisie",
              aria: { describedby: id_erreur, invalid: (erreur ? "true" : nil) },
              data: { formulaire_target: "champ", action: "blur->formulaire#verifier input->formulaire#corriger" },
              **champ[:attrs] %>
        <p class="formulaire__erreur" id="<%= id_erreur %>"<%= " hidden" unless erreur %>><%= erreur %></p>
      </div>
    <% end %>

    <button type="submit" class="formulaire__bouton" data-formulaire-target="bouton">
      Envoyer <span aria-hidden="true">→</span>
    </button>

    <% statut = flash[:notice] || flash[:alert] %>
    <p class="formulaire__statut <%= 'formulaire__statut--erreur' if flash[:alert] %>"
       role="status" data-formulaire-target="statut"<%= " hidden" unless statut %>><%= statut %></p>
  <% end %>
</section>
