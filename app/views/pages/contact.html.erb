<div class="contact-page-full">
  <div class="contact-form-container">
    <h1>Stay in touch</h1>
    <p>We’d love to hear from you! Drop us a message, and we’ll connect with you soon.</p>
    <%= form_with url: contacts_path, method: :post, local: true, html: { class: 'contact-form' } do |f| %>
      <div class="form-group">
        <%= f.text_field :name, placeholder: 'Name', class: 'form-control' %>
      </div>

      <div class="form-group">
        <%= f.email_field :email, placeholder: 'Email', class: 'form-control' %>
      </div>

      <div class="form-row">
        <div class="form-group code-group">
          <%= f.select :country_code,
                options_for_select([['+1', '+1'], ['+44', '+44'], ['+33', '+33']]),
                {}, class: 'form-control' %>
        </div>
        <div class="form-group phone-group">
          <%= f.telephone_field :phone, placeholder: 'Phone', class: 'form-control' %>
        </div>
      </div>

      <div class="form-group">
        <%= f.text_area :message, placeholder: 'Message…', rows: 5, class: 'form-control' %>
      </div>

      <div class="form-group">
        <%= f.submit 'Submit', class: 'btn btn-submit' %>
      </div>
    <% end %>
  </div>
</div>
