<div class="container-fluid px-4 px-md-5 my-4 bg-primary text-dark">
  <h5 class="text-end clash-font blue-font-sous-titre mt-5 mb-5 text-dark"> > bio </h5>

  <div class="row gy-4 flex-grow-1 align-items-end">

    <!-- Colonne de gauche -->
    <div class="col-md-4 text-start text-dark">
      <h2 class="clash-font mb-3 text-dark">
        Design par<br>
        <strong>Fabien Hoarau</strong>,<br>
        designer UI/UX<br>
        et développeur<br>
        front-end<br>
        basé à Bordeaux.
      </h2>
    </div>

    <!-- Colonne centrale -->
    <div class="col-md-4 d-flex justify-content-center text-dark">
      <div class="bio-image-card">
        <%= image_tag "bio_image.png",
              class: "img-fluid rounded",
              alt: "bio_image" %>
      </div>
    </div>

    <!-- Colonne de droite -->
    <div class="col-md-4">
      <p>
        Je suis graphiste et designer UI/UX avec plus de 5 ans d’expérience.
        Mon travail allie créativité et fonctionnalité pour offrir des expériences…
        Avec un riche portfolio et une passion pour l’innovation, je contribue…
      </p>
    </div>

  </div>
</div>
