        <%= link_to "https://www.linkedin.com/in/fabien-hoarau", target: "_blank" do %>
          <%= image_tag "logo-link-y.png",
                class: "rounded",
                style: "width:60px; height:auto;",
                alt: "LinkedIn" %>
        <% end %>
        <%= link_to "https://github.com/fabien-hoarau", target: "_blank" do %>
          <%= image_tag "logo-git-y.png",
                class: "rounded",
                style: "width:60px; height:auto;",
                alt: "GitHub" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
