<div class="container-fluid px-4 px-md-5 my-4  text-primary">
  <%# <h1 class="text-start mt-5 mb-5 text-primary"> > bio </h1> %>

  <!-- Utilise row-cols pour empiler en mobile et passer à 3 colonnes dès md -->
  <div class="row row-cols-1 row-cols-md-2 g-4 align-items-center align-items-md-end">

    <!-- Colonne de gauche -->
    <div class="col text-start text-primary">
      <h1 class="mb-3 text-primary clash-font-bold font-link">Fabien Hoarau</h1>
      <h2 class="fs-3">Creative front end developer<br>Graphic designer<br>UI/UX designer</h2>
      <p class="text-primary lead">
        Je crée, j’anime et je code. <br>
        Je suis un graphiste et motion designer, avec une vraie
        spécialisation en UI et en front.
      </p>
    </div>

    <!-- Colonne centrale -->
    <div class="col d-flex justify-content-center text-primary">
      <div class="bio-image-card">
        <%= image_tag "bio_image.png",
              class: "img-fluid rounded",
              alt: "bio_image" %>
      </div>
    </div>


  </div>
</div>  <!-- fermeture du container principal -->






<div class="container-fluid px-4 px-md-5 my-4 py-5" style="background-color: #ffff00;">
  <div class="row justify-content-start">
    <div class="col-lg-8 text-start px-4">
      <h2 class="mb-4 text-dark"> > soft skills</h2>
      <p class="text-dark lead">
        Certifié par le bootcamp Le Wagon pour renforcer ma capacité dev avec Ruby
        on Rails, SQL et Bootstrap, j’aime travailler en équipe, organiser un projet
        sur GitHub et déployer efficacement. <br><br>

        J’ai aussi appris à tirer avantage de l’IA
        dans le code et dans le design. Tout ceci a été mis en application à travers
        les clients des boîtes de com où j’ai pu réaliser des projets dans des domaines
        tels que la restauration, la culture, le spectacle ou encore le transport aérien.<br><br>

        Ce mélange de créativité et de technique me permet de prototyper vite et de livrer
        des expériences soignées, avec des interfaces propres et responsives.
      </p>
    </div>
  </div>
</div>

<div class="container-fluid px-4 px-md-5 my-4 py-5" style="background-color: #171717;">
  <div class="row justify-content-start">
    <div class="col-lg-8 text-start px-4">
      <h2 class=" mb-4 text-primary"> >  hard skills</h2>
      <p class="text-primary lead">
        Côté outils, je travaille au quotidien avec la suite Adobe et Figma :</p>
        <ul class="text-primary lead">
          <li>Adobe Illustrator</li>
          <li>Adobe Photoshop</li>
          <li>Adobe InDesign</li>
          <li>Adobe After Effects</li>
          <li>Adobe Premiere Pro</li>
          <li>Figma</li>
        </ul>
        <br>
         <p class="text-primary lead">Côté dev, je code en HTML,
        CSS, JavaScript, Ruby on Rails et SQL, Bootstrap.
        </p>
  </div>
  </div>
</div>

<div class="container-fluid px-0 my-0 py-0" style="background-color: #171717;">
  <div class="row justify-content-start px-4 py-4">
    <div class="col-lg-8 px-5">
      <div class="row align-items-center">
        <!-- CV button à gauche -->
        <div class="col-12 col-md-4 d-flex justify-content-start">
          <%= link_to asset_path('FabienHoarauCV2.pdf'),
                     download: 'FabienHoarauCV2.pdf',
                     class: 'btn btn-outline-primary' do %>
            Télécharger mon CV
          <% end %>
        </div>

        <!-- colonne centrale vide pour équilibrer -->
        <div class="col-12 col-md-4"></div>

        <!-- Liens LinkedIn & GitHub à droite -->
        <div class="col-12 col-md-4 d-flex justify-content-start gap-4">
          <%= link_to "https://www.linkedin.com/in/fabien-hoarau-7b896a172/",
                      target: "_blank", rel: "noopener noreferrer" do %>
            <%= image_tag "logo-link-y.png",
                          class: "rounded",
                          style: "width:60px; height:auto;",
                          alt: "LinkedIn" %>
          <% end %>
          <%= link_to "https://github.com/ElPoncho-arch/rails-folio",
                      target: "_blank", rel: "noopener noreferrer" do %>
            <%= image_tag "logo-git-y.png",
                          class: "rounded",
                          style: "width:60px; height:auto;",
                          alt: "GitHub" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>


