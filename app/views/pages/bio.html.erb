<%# Hero section %>
<section class="bio-hero container-fluid px-4 px-md-5 pt-5 pb-3">
  <div class="row align-items-end">
    <div class="col-12 col-md-8">
      <h1 class="bio-name text-primary mb-2">Fabien<br>Hoarau</h1>
      <p class="bio-subtitle text-primary">
        Creative front-end developer — Graphic designer — UI/UX designer
      </p>
      <p class="text-primary lead mt-3">
        Je crée, j'anime et je code.<br>
        Graphiste et motion designer avec une vraie spécialisation UI et front.
      </p>
    </div>
    <div class="col-12 col-md-4 bio-portrait-col">
      <%= image_tag "bio_image.png", class: "bio-portrait", alt: "Fabien Hoarau" %>
    </div>
  </div>
</section>

<%# Profil section %>
<section class="container-fluid px-4 px-md-5 py-5 bio-yellow">
  <div class="row align-items-start">
    <div class="col-12 col-md-4">
      <span class="bio-label">> profil</span>
      <p class="bio-accroche text-dark mt-3">Créer.<br>Animer.<br>Coder.</p>
    </div>
    <div class="col-12 col-md-8 pt-4 pt-md-0">
      <p class="text-dark lead">
        Certifié par le bootcamp Le Wagon, je maîtrise Ruby on Rails, SQL et Bootstrap.
        J'aime travailler en équipe, organiser un projet sur GitHub et déployer efficacement.
      </p>
      <p class="text-dark lead">
        J'ai appris à tirer avantage de l'IA dans le code et dans le design.
        Mes projets couvrent la restauration, la culture, le spectacle et le transport aérien.
      </p>
      <p class="text-dark lead">
        Ce mélange de créativité et de technique me permet de prototyper vite et de livrer
        des expériences soignées, avec des interfaces propres et responsives.
      </p>
    </div>
  </div>
</section>

<%# Skills section %>
<section class="container-fluid px-4 px-md-5 py-5 bio-dark">
  <div class="row">
    <div class="col-12 col-md-6 mb-5 mb-md-0">
      <span class="bio-label text-primary">> design tools</span>
      <div class="bio-tags mt-4">
        <% ["Illustrator", "Photoshop", "InDesign", "After Effects", "Premiere Pro", "Figma"].each do |tool| %>
          <span class="bio-tag"><%= tool %></span>
        <% end %>
      </div>
    </div>
    <div class="col-12 col-md-6">
      <span class="bio-label text-primary">> dev tools</span>
      <div class="bio-tags mt-4">
        <% ["HTML/CSS", "JavaScript", "Ruby on Rails", "SQL", "Bootstrap"].each do |tool| %>
          <span class="bio-tag"><%= tool %></span>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%# CTA section %>
<section class="container-fluid px-4 px-md-5 py-5 bio-dark bio-cta">
  <div class="d-flex flex-wrap justify-content-center align-items-center gap-4">
    <%= link_to asset_path('FabienHoarau_Graphiste.pdf'), target: "_blank", rel: "noopener noreferrer",class: '' do %>
      <%= image_tag "logo-CV.png", class: "rounded", style: "width:60px; height:auto;", alt: "CV" %>
    <% end %>
    <%= link_to "https://www.linkedin.com/in/fabien-hoarau-7b896a172/", target: "_blank", rel: "noopener noreferrer" do %>
      <%= image_tag "logo-link-y.png", class: "rounded", style: "width:60px; height:auto;", alt: "LinkedIn" %>
    <% end %>
    <%= link_to "https://github.com/ElPoncho-arch/rails-folio", target: "_blank", rel: "noopener noreferrer" do %>
      <%= image_tag "logo-git-y.png", class: "rounded", style: "width:60px; height:auto;", alt: "GitHub" %>
    <% end %>
  </div>
</section>
