<!DOCTYPE html>
<html lang="fr" data-controller="smooth-scroll">
  <head>
    <%# Titre par page : content_for :titre dans la vue ; la home garde le titre de repli %>
    <title><%= content_for?(:titre) ? "#{yield(:titre)} — Fabien Hoarau" : "Fabien Hoarau — graphique, motion, UI et front-end designer" %></title>
    <%# Thème clair uniquement : empêche Chrome (Android) et Samsung Internet d'assombrir la page de force %>
    <meta name="color-scheme" content="only light">
    <meta name="description" content="Fabien Hoarau, graphique, motion, UI et front-end designer. Identités visuelles, animation et interfaces web.">

    <%# Loader de première arrivée (intro_controller.js) : décidé avant le premier affichage, une fois par session.
        « intro-en-cours » = à montrer ; « intro-vue » = déjà vu, le voile n'est jamais affiché %>
    <%= javascript_tag nonce: true, data: { turbo_eval: false } do %>
      try { document.documentElement.classList.add(sessionStorage.getItem("intro-vue") ? "intro-vue" : "intro-en-cours") }
      catch (e) { document.documentElement.classList.add("intro-vue") }
    <% end %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Favicon : pastille « fh » tramée, en PNG seulement (le SVG source, docs/sources/favicon-trame.svg,
        pèse 629 Ko à cause de la trame : trop lourd pour une icône) %>
    <%= favicon_link_tag "/favicon-32x32.png", rel: "icon", type: "image/png", sizes: "32x32" %>
    <%= favicon_link_tag "/apple-touch-icon.png", rel: "apple-touch-icon", type: "image/png", sizes: "180x180" %>
    <%= tag.meta name: "viewport", content: "width=device-width, initial-scale=1, shrink-to-fit=no" %>

    <%# Polices des premiers mots affichés (nom, métier, nav) : chargées dès le début, en même temps que
        la feuille de style, au lieu d'être découvertes après elle (évite la typo de secours puis le saut) %>
    <%= preload_link_tag "ClashDisplay-Variable.woff2" %>
    <%= preload_link_tag "fragment-mono-v6-latin-regular.woff2" %>

    <!-- Tes styles (Bootstrap inclus via gem + overrides) -->
    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>

    <!-- Importmap (charge application.js + pins) -->
    <%= javascript_importmap_tags %>

  </head>

  <!-- Attache le contrôleur de transition au body -->
  <body data-controller="transition">
    <%# Voile du loader (intro_controller.js, _intro.scss) : décoratif, ne bloque ni la lecture ni les clics %>
    <div class="intro" data-controller="intro" aria-hidden="true">
      <canvas class="intro__canvas" data-intro-target="canvas"></canvas>
    </div>
    <a class="lien-evitement" href="#contenu" data-action="smooth-scroll#evitement">Aller au contenu</a>

    <div id="app-loader" aria-hidden="true">
      <div class="loader-spinner"></div>
    </div>

    <%= render 'shared/navbar' %>

    <!-- Contenu principal, conteneur animé (fade/slide entre pages) ; cible du lien d'évitement -->
    <main id="contenu" class="transition-fade is-entering <%= yield(:main_classe) %>" tabindex="-1" data-transition-target="container" data-controller="reveal">
      <%= yield %>
    </main>


    <%= render "shared/footer" %>


    <!-- Overlay léger pendant la sortie (optionnel) -->
    <div id="page-overlay" data-transition-target="overlay" aria-hidden="true"></div>
  </body>


</html>
