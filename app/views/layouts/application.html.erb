<!DOCTYPE html>
<html>
  <head>
    <title>RailsFolio</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- 1) le CSS tiers (intl-tel-input) -->
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/intl-tel-input@17.0.8/build/css/intlTelInput.css",
          media: 'all', 'data-turbo-track': 'reload' %>

    <!-- 2) Bootstrap (via CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- 3) Ton application.css en dernier pour qu’il puisse override Bootstrap -->
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>
    <!-- JS de la lib (global window.intlTelInput) -->
    <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/intl-tel-input@17.0.8/build/js/intlTelInput.min.js",
          defer: true, 'data-turbo-track': 'reload' %>

    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% unless controller_name == 'home' && action_name == 'index' %>
      <%= render 'shared/navbar' %>
    <% end %>

    <%= yield %>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"></script>
  </body>
</html>
