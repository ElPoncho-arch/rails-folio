<!DOCTYPE html>
<html lang="fr" data-controller="smooth-scroll">
  <head>
    <%# Titre par page : content_for :titre dans la vue ; la home garde le titre de repli %>
    <title><%= content_for?(:titre) ? "#{yield(:titre)} — Fabien Hoarau" : "Fabien Hoarau — graphiste, motion & UI" %></title>
    <meta name="description" content="Fabien Hoarau, graphiste et designer web. Branding, print, web et créations personnelles">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag "/favicon-32x32.png", rel: "icon", type: "image/png", sizes: "32x32" %>
    <%= tag.meta name: "viewport", content: "width=device-width, initial-scale=1, shrink-to-fit=no" %>

    <!-- Tes styles (Bootstrap inclus via gem + overrides) -->
    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>

    <!-- Importmap (charge application.js + pins) -->
    <%= javascript_importmap_tags %>

  </head>

  <!-- Attache le contrôleur de transition au body -->
  <body data-controller="transition">
    <a class="lien-evitement" href="#contenu" data-action="smooth-scroll#evitement">Aller au contenu</a>

    <div id="app-loader" aria-hidden="true">
      <div class="loader-spinner"></div>
    </div>

    <%= render 'shared/navbar' %>

    <!-- Contenu principal, conteneur animé (fade/slide entre pages) ; cible du lien d'évitement -->
    <main id="contenu" class="transition-fade is-entering" tabindex="-1" data-transition-target="container" data-controller="reveal">
      <%= yield %>
    </main>


    <%= render "shared/footer" %>


    <!-- Overlay léger pendant la sortie (optionnel) -->
    <div id="page-overlay" data-transition-target="overlay" aria-hidden="true"></div>
  </body>


</html>
