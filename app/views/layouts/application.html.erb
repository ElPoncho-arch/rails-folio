<!DOCTYPE html>
<html>
  <head>
    <title>Fabien Hoarau</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag "/favicon-32x32.png", rel: "icon", type: "image/png", sizes: "32x32" %>
    <%= tag.meta name: "viewport", content: "width=device-width, initial-scale=1, shrink-to-fit=no" %>

    <!-- Bootstrap CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Tes styles (écrasent Bootstrap) -->
    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>

    <!-- Importmap (charge application.js + pins) -->
    <%= javascript_importmap_tags %>

    <div id="app-loader" aria-hidden="true" data-transition-target="overlay">
      <div class="loader-spinner"></div>
    </div>


  </head>

  <!-- Attache le contrôleur de transition au body -->
  <body data-controller="transition">
    <% unless controller_name == 'home' && action_name == 'index' %>
      <%= render 'shared/navbar' %>
    <% end %>

    <!-- Conteneur animé (fade/slide entre pages) -->
    <div id="page" class="transition-fade is-entering" data-transition-target="container">
      <%= yield %>
    </div>


<% if controller_name == "projects" %>
      <%= render "shared/footer" %>
    <% end %>

    
    <!-- Overlay léger pendant la sortie (optionnel) -->
    <div id="page-overlay" data-transition-target="overlay" aria-hidden="true"></div>
  </body>


</html>
