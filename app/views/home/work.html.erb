<div class="container-fluid px-4 px-md-5 my-4" data-controller="work">
  <div class="cards">
    <%= link_to '/projects/shelfie',
          class: 'project-card d-block text-decoration-none h-100',
          style: "background-image: url(#{image_path('shelfie/logoshelfie.jpg', fetch_format: :auto, quality: :auto)}); background-size: cover; background-position: center;",
          data: { work_target: "card", project_name: "Shelfie" } do %>
    <% end %>

    <%= link_to '/projects/slides',
          class: 'project-card video-card d-block text-decoration-none h-100',
          data: { work_target: "card", project_name: "Slides" } do %>
      <%= cl_video_tag "slides_logo_anim_meykfx",
          autoplay: true, muted: true, loop: true, playsinline: true, preload: "auto",
          class: "video-bg",
          transform: { fetch_format: :auto, quality: :auto } %>
    <% end %>
  </div>

  <div class="cards my-5">
    <%= link_to '/projects/macval',
          class: 'project-card video-card d-block text-decoration-none h-100',
          data: { work_target: "card", project_name: "Mac Val" } do %>
      <%= cl_video_tag "macval-logo-anim_syyto5",
          autoplay: true, muted: true, loop: true, playsinline: true, preload: "auto",
          class: "video-bg",
          transform: { fetch_format: :auto, quality: :auto } %>
    <% end %>

    <%= link_to '/projects/tf1',
          class: 'project-card d-block text-decoration-none h-100',
          style: "background-image: url(#{image_path('tf1/lou.png', fetch_format: :auto, quality: :auto)}); background-size: cover; background-position: center;",
          data: { work_target: "card", project_name: "TF1" } do %>
    <% end %>
  </div>

  <div class="cards my-5">
    <%= link_to '/projects/ford',
          class: 'project-card d-block text-decoration-none h-100',
          style: "background-image: url(#{image_path('ford_couv.jpg')}); background-size: cover; background-position: center;",
          data: { work_target: "card", project_name: "Ford" } do %>
    <% end %>

    <%= link_to '/projects/abskate',
          class: 'project-card d-block text-decoration-none h-100',
          style: "background-image: url(#{image_path('abskate_couv.jpg', fetch_format: :auto, quality: :auto)}); background-size: cover; background-position: center;",
          data: { work_target: "card", project_name: "ABSkate" } do %>
    <% end %>
  </div>

  <div class="cards">
    <%= link_to '/projects/mango',
          class: 'project-card video-card d-block text-decoration-none h-100',
          data: { work_target: "card", project_name: "Mango Édition" } do %>
      <%= cl_video_tag "mango-anim-logo_pcycx6",
          autoplay: true, muted: true, loop: true, playsinline: true, preload: "auto",
          class: "video-bg",
          transform: { fetch_format: :auto, quality: :auto } %>
    <% end %>

    <%= link_to '/projects/la_colline',
          class: 'project-card d-block text-decoration-none h-100',
          style: "background-image: url(#{image_path('la_colline_couv2.jpg', fetch_format: :auto, quality: :auto)}); background-size: cover; background-position: center;",
          data: { work_target: "card", project_name: "La Colline" } do %>
    <% end %>
  </div>
</div>
