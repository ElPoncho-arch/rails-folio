<%# Home V2 — hero : portrait tramé brique (motifs/trame.svg) sur fond orange, nom en haut à gauche, métier en bas à droite
    (hero_motif_controller.js : entrée puis dérive lente du motif ; motifs dans app/assets/images/motifs) ;
    cards des projets avec image (projet_apercu_url) ; apparitions : reveal_controller.js.
    Le hero démarre tout en haut, sous la nav flottante (classe « contenu--plein » sur <main>). %>
<% content_for :main_classe, "contenu--plein" %>

<%# Hero %>
<section class="home-hero" data-controller="hero-motif">
  <div class="home-hero__motif" data-hero-motif-target="motif" aria-hidden="true"></div>
  <h1 class="home-hero__nom" data-hero-motif-target="texte">
    <span class="home-hero__ligne">fabien</span> <span class="home-hero__ligne">hoarau</span>
  </h1>
  <p class="home-hero__metier" data-hero-motif-target="texte">
    <span class="home-hero__ligne">Graphique, motion,</span> <span class="home-hero__ligne">UI et front-end designer</span>
  </p>
</section>

<%# Liste des projets %>
<section id="projets" class="home-projects" aria-labelledby="projets-titre"
         data-controller="filtre" data-action="click@document->filtre#clicDehors keydown.esc->filtre#echap">
  <%# Titre à gauche, filtre à droite. Filtre par tag (filtre_controller.js) : menu déroulant flottant,
      un seul tag actif à la fois. Bouton masqué sans JavaScript (la grille reste complète). %>
  <div class="home-projects__entete">
    <h2 id="projets-titre" class="home-projects__titre" data-reveal-target="item">projets <span>(<span data-filtre-target="compteur"><%= format("%02d", projets.size) %></span>)</span></h2>

    <div class="filtre" data-reveal-target="item" data-filtre-target="filtre" data-action="focusout->filtre#focusDehors">
      <div class="filtre__commandes">
        <button type="button" class="filtre__ouvrir" hidden aria-expanded="false" aria-controls="filtre-panneau"
                data-filtre-target="ouvrir" data-action="filtre#basculer">
          <span data-filtre-target="libelle">filtrer</span>
          <span class="filtre__signe" aria-hidden="true" data-filtre-target="signe">+</span>
        </button>
        <button type="button" class="filtre__effacer" hidden aria-label="Retirer le filtre"
                data-filtre-target="effacer" data-action="filtre#effacer">
          <span aria-hidden="true">×</span>
        </button>
      </div>

      <div id="filtre-panneau" class="filtre__panneau" role="group" aria-label="Filtrer les projets" hidden data-filtre-target="panneau">
        <button type="button" class="filtre__bouton" aria-pressed="true" data-filtre-target="bouton" data-action="filtre#choisir">
          tous <span class="filtre__nombre"><%= projets.size %></span>
        </button>
        <% projets_tags.each do |tag, nombre| %>
          <button type="button" class="filtre__bouton" aria-pressed="false" data-filtre-target="bouton" data-tag="<%= tag %>" data-action="filtre#choisir">
            <%= tag %> <span class="filtre__nombre"><%= nombre %></span>
          </button>
        <% end %>
      </div>
    </div>
  </div>
  <p class="visually-hidden" aria-live="polite" data-filtre-target="annonce"></p>

  <%# Grille de cards carrées : 1 colonne en mobile, 2 dès 640 px, 3 dès 900 px %>
  <ol class="home-projects__list">
    <% projets.each do |projet| %>
      <% image = projet_apercu_url(projet) %>
      <li data-reveal-target="item" data-filtre-target="carte" data-tags="<%= projet[:tags].join(" ") %>">
        <%# Toute la card est le lien. Image : la première disponible du projet (aucune → fond tomate).
            alt vide : le nom du projet, dans le lien, suffit. %>
        <%= link_to projet_path_for(projet), class: ["projet-card", ("projet-card--image" if image)] do %>
          <% if image %>
            <img class="projet-card__image" src="<%= image %>" alt="" loading="lazy" decoding="async">
          <% end %>
          <span class="projet-card__nom"><span class="projet-card__nom-texte"><%= projet[:nom] %></span></span>
          <%# Catégories visuelles seulement : le lien est annoncé par le nom du projet %>
          <span class="capsules" aria-hidden="true">
            <% projet[:tags].each do |tag| %>
              <span class="capsule"><%= tag %></span>
            <% end %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ol>
</section>
