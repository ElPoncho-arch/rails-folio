<div class="container-fluid px-4 px-md-5 min-vh-100"
     style="background: url(<%= asset_path 'home-back.jpg' %>) no-repeat center/cover;">

  <div class="home-section">


    <div class="d-flex justify-content-between align-items-start">
      <h1 class="clash-font-bold font-title m-0">Fabien</h1>
      <h1 class="clash-font-bold font-title m-0">Hoarau</h1>
    </div>


    <div class="d-flex flex-wrap align-items-center justify-content-start">
      <h5 class="text-start text-primary fs-3 mb-0 me-4">
