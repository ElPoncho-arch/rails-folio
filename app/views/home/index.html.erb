<%# Home V2 — hero : portrait tramé (motifs/trame.svg) sur fond tomate, nom en haut à gauche, métier en bas à droite
    (hero_motif_controller.js : entrée puis dérive lente du motif ; motifs dans app/assets/images/motifs) ;
    cards des projets avec image (projet_apercu_url) ; apparitions : reveal_controller.js.
    Le hero démarre tout en haut, sous la nav flottante (classe « contenu--plein » sur <main>). %>
<% content_for :main_classe, "contenu--plein" %>

<%# Hero %>
<section class="home-hero" data-controller="hero-motif">
  <div class="home-hero__motif" data-hero-motif-target="motif" aria-hidden="true"></div>
  <h1 class="home-hero__nom" data-hero-motif-target="texte">
    <span class="home-hero__ligne">fabien</span> <span class="home-hero__ligne">hoarau</span>
  </h1>
  <p class="home-hero__metier" data-hero-motif-target="texte">
    <span class="home-hero__ligne">Graphiste, motion,</span> <span class="home-hero__ligne">UI et front</span>
  </p>
</section>

<%# Liste des projets %>
<section id="projets" class="home-projects" aria-labelledby="projets-titre">
  <h2 id="projets-titre" class="home-projects__titre" data-reveal-target="item">projets <span>(<%= format("%02d", projets.size) %>)</span></h2>

  <%# Grille de cards carrées : 1 colonne en mobile, 2 dès 640 px, 3 dès 900 px %>
  <ol class="home-projects__list">
    <% projets.each do |projet| %>
      <% image = projet_apercu_url(projet) %>
      <li data-reveal-target="item">
        <%# Toute la card est le lien. Image : la première disponible du projet (aucune → fond tomate).
            alt vide : le nom du projet, dans le lien, suffit. %>
        <%= link_to projet_path_for(projet), class: ["projet-card", ("projet-card--image" if image)] do %>
          <% if image %>
            <img class="projet-card__image" src="<%= image %>" alt="" loading="lazy" decoding="async">
          <% end %>
          <span class="projet-card__nom"><span class="projet-card__nom-texte"><%= projet[:nom] %></span></span>
          <span class="capsules">
            <% projet[:tags].each do |tag| %>
              <span class="capsule"><%= tag %></span>
            <% end %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ol>
</section>
